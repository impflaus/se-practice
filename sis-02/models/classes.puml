@startuml
skinparam classAttributeIconSize 0

class Student {
    - studentId: String
    - name: String
}

class Course {
    - courseCode: String
    - title: String
    - description: String
}

class CourseOffering {
    - offeringId: String
    - section: String
    - semester: String
    - capacity: Integer
    - enrolledCount: Integer
    + getAvailablePlaces(): Integer
    + isStudentEnrolled(studentId: String): Boolean
    + getCurrentCountAndCapacity(): IntegerPair
    + incrementEnrolledCount(): Void
}

class Enrollment {
    - enrollmentId: String
    - enrollmentDate: DateTime
}

Course "1" -- "0..*" CourseOffering : defines >
Student "1" -- "0..*" Enrollment : holds >
CourseOffering "1" -- "0..*" Enrollment : receives >

note right of CourseOffering
    Capacity constraint (R2):
    capacity > 0
    0 <= enrolledCount <= capacity

    availablePlaces = capacity - enrolledCount

    enrolledCount equals the number
    of Enrollment records for this offering.
end note

note bottom of Enrollment
    Uniqueness constraint (R3):

    A Student may have at most one
    Enrollment for each CourseOffering.

    Each Enrollment links exactly
    one Student and one CourseOffering.
end note

@enduml